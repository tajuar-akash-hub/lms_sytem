# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Primary app DB (used at runtime). Pooled connection — use this for app servers.
DATABASE_URL=postgresql://user:password@host-pooler/db?sslmode=require

# Optional: same DB, unpooled (for one-off scripts / migrations that need
# long-lived connections, e.g. alembic). Same credentials, different host.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require